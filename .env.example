# =========================
# Public queue API settings
# =========================
PORT=8000

# =================
# Queue throughput
# =================
# Max number of jobs the worker can process per 60 seconds.
# Extra requests stay in Redis and are processed FIFO.
MAX_REQUESTS_PER_MINUTE=10

# Number of jobs processed in parallel by the worker.
# Keep this at 1 for stable memory usage on small machines.
WORKER_CONCURRENCY=1

# BullMQ lock duration for one active job (milliseconds).
# Increase this for slower model loads/inference to avoid premature stalled detection.
WORKER_LOCK_DURATION_MS=300000

# How often BullMQ checks stalled jobs (milliseconds).
WORKER_STALLED_INTERVAL_MS=30000

# Retry limit for stalled jobs before failing them.
WORKER_MAX_STALLED_COUNT=1

# Max time queue-api waits for a completed job response (milliseconds).
JOB_TIMEOUT_MS=300000

# ======================
# Queue infrastructure
# ======================
REDIS_URL=redis://redis:6379
QUEUE_NAME=litevlm_requests
MODEL_API_BASE_URL=http://model-api:8000

# ==========================
# Request payload boundaries
# ==========================
# Max upload size for /generate image file.
UPLOAD_LIMIT_MB=10

# Max JSON body size for /chat and /v1/chat/completions.
JSON_BODY_LIMIT_MB=25

# ==============================
# API authentication (queue-api)
# ==============================
# queue-api reads allowed Bearer tokens from this JSON file.
AUTH_TOKENS_FILE=/app/auth-tokens.json

# ==============================
# Hugging Face authentication
# ==============================
# HF token for gated models (e.g., Gemma 3, Llama 2)
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# ========================
# Model runtime parameters
# ========================
DEVICE=cpu
DEFAULT_MAX_NEW_TOKENS=64
MAX_NEW_TOKENS_LIMIT=256
LOG_LEVEL=INFO

# ============================
# Model selection and loading
# ============================
# Default model alias when request does not send a model value.
# Allowed aliases: smolvlm-256m, qwen-1.5b
DEFAULT_MODEL_ALIAS=smolvlm-256m

# Model IDs behind aliases.
SMOLVLM_MODEL_ID=HuggingFaceTB/SmolVLM-256M-Instruct
QWEN_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# If true, only one model stays loaded at a time.
# When a different model is selected, the currently loaded one is unloaded first.
SINGLE_ACTIVE_MODEL=false

# Idle unload policy:
# If a loaded model is not used for this many seconds, it is unloaded from memory.
MODEL_IDLE_UNLOAD_SECONDS=3600

# How often cleanup checks for idle models (seconds).
MODEL_CLEANUP_INTERVAL_SECONDS=60
